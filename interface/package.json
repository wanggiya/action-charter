{
  "name": "actioncharter-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "browser:test:24": "node ../scripts/checkpoint24_browser_check.mjs",
    "browser:test:25": "node ../scripts/checkpoint25_browser_check.mjs",
    "browser:test:26-tasks": "node ../scripts/checkpoint26_task_browser_check.mjs",
    "browser:test:26-recipes": "node ../scripts/checkpoint26_recipe_runs_browser_check.mjs",
    "browser:test:26-planner": "node ../scripts/checkpoint26_planner_browser_check.mjs",
    "browser:test:27-calculations": "node ../scripts/checkpoint27_calculation_browser_check.mjs",
    "browser:test:27-critic": "node ../scripts/checkpoint27_critic_browser_check.mjs",
    "browser:test:27-writes": "node ../scripts/checkpoint27_write_policy_browser_check.mjs",
    "browser:test:27-retention": "node ../scripts/checkpoint27_retention_browser_check.mjs",
    "browser:test:27-hook-refresh": "node ../scripts/checkpoint27_hook_refresh_browser_check.mjs",
    "browser:test:27-report-authorization": "node ../scripts/checkpoint27_report_authorization_browser_check.mjs",
    "browser:test:27-visualization": "node ../scripts/checkpoint27_visualization_browser_check.mjs",
    "browser:test:27-results": "node ../scripts/checkpoint27_results_workspace_browser_check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "playwright": "1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
