# Copy to .env. Never commit .env or put secrets in prompts/traces/reports.
POSTGRES_DB=geoagent
POSTGRES_USER=geoagent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# Existing shared Docker network and alias for the existing PostGIS container.
GEOAGENT_BACKEND_NETWORK=geoagent-backend

# Ollama runs once on the Windows/WSL host, not in each agent container.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_NAME=qwen3:8b
MODEL_TIMEOUT_SECONDS=120

# Prototype flag. Local Ollama access is required, public Internet is not.
NETWORK_ENABLED=local-model-only
